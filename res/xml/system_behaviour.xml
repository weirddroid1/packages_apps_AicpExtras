<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:aicpextras="http://schemas.android.com/apk/res-auto"
    android:key="system_behaviour"
    android:title="@string/system_behaviour_title">

    <PreferenceCategory
        android:title="@string/system_behaviour_title">

        <androidx.preference.SwitchPreferenceCompat
            android:key="enable_blurs_on_windows"
            android:title="@string/enable_blurs_on_windows_title"
            android:summary="@string/enable_blurs_on_windows_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/spoofing_title">

        <com.aicp.gear.preference.SecureSettingMasterSwitchPreference
            android:key="spoofing"
            android:title="@string/spoofing_title"
            android:summary="@string/spoofing_summary"
            android:defaultValue="false" />

        <com.aicp.extras.preference.KeyboxDataPreference
            android:key="keybox_data_setting"
            android:title="@string/keybox_data_title"
            android:summary="@string/keybox_data_summary"
            android:dependency="spoofing" />

        <com.aicp.extras.preference.PifDataPreference
            android:key="pif_data_setting"
            android:title="@string/pif_data_title"
            android:summary="@string/pif_data_summary"
            android:dependency="spoofing" />

        <Preference
            android:key="pixel_spoofing_apps"
            android:title="@string/pixel_spoofing_apps_title"
            android:fragment="com.aicp.extras.fragments.PixelSpoofingAppsSettings"
            android:dependency="spoofing" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/system_extensions_title">

        <com.aicp.gear.preference.SystemPropertiesSwitchPreference
            android:key="persist.aicp.hosts_block"
            android:title="@string/hosts_block_title"
            android:summary="@string/hosts_block_summary"
            android:defaultValue="false" />

        <com.aicp.gear.preference.SystemSettingSwitchPreference
            android:key="smart_5g"
            android:title="@string/smart_5g_title"
            android:summary="@string/smart_5g_summary"
            android:defaultValue="false" />

        <Preference
            android:key="system_app_remover"
            android:title="@string/system_app_remover_title"
            android:summary="@string/system_app_remover_summary">
            <intent
                android:action="android.intent.action.MAIN"
                android:targetPackage="com.aicp.extras"
                android:targetClass="com.aicp.extras.SystemappRemover" />
        </Preference>

    </PreferenceCategory>
</PreferenceScreen>
